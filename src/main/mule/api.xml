<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:jms="http://www.mulesoft.org/schema/mule/jms"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/jms http://www.mulesoft.org/schema/mule/jms/current/mule-jms.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">
    <http:listener-config name="api-httpListenerConfig">
        <http:listener-connection host="0.0.0.0" port="8081" />
    </http:listener-config>
    <apikit:config name="api-config" api="api.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
	<flow name="api-main">
        <http:listener config-ref="api-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="api-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Bad request"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Method not allowed"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">405</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not acceptable"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">406</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Unsupported media type"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">415</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not Implemented"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">501</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="api-console">
        <http:listener config-ref="api-httpListenerConfig" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="api-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="delete:\appointments\(appointmentId):api-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="appointmentId"><![CDATA[%dw 2.0
output application/java
---
attributes.uriParams.'appointmentId']]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <db:select doc:name="Select" doc:id="ec05ad19-3cfd-4470-a1a9-aeb92df5d995" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT appointment_id, slot_id, status
FROM appointments
WHERE appointment_id = :appointmentId]]></db:sql>
			<db:input-parameters ><![CDATA[#[{appointmentId: vars.appointmentId}]]]></db:input-parameters>
		</db:select>
		<choice doc:name="Choice" doc:id="6e1b0964-0287-4b2b-9c35-badc6a0c2e93" >
			<when expression="#[isEmpty(payload)]">
				<set-variable value="#[404]" doc:name="Set Variable" doc:id="e2c9f294-f2ae-43cd-9405-c71ecae23090" variableName="httpStatus"/>
				<ee:transform doc:name="Transform Message" doc:id="fd91a754-4681-4070-914c-682ca3d3cb8f" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  error: "APPOINTMENT_NOT_FOUND",
  message: "Appointment not found"
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise >
				<choice doc:name="Choice" doc:id="8476b407-36a9-4673-b526-aa3c278aa42d" >
					<when expression='#[upper(payload[0].status as String) == "CANCELLED"]'>
						<set-variable value="#[409]" doc:name="Set Variable" doc:id="1abd2891-a935-435d-81d3-a95e0cd67c66" variableName="httpStatus"/>
						<ee:transform doc:name="Transform Message" doc:id="1e42a8a2-b235-4637-8ef5-67d4d71765a3" >
							<ee:message >
								<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  error: "APPOINTMENT_ALREADY_CANCELLED",
  message: "Appointment is already cancelled"
}]]></ee:set-payload>
							</ee:message>
						</ee:transform>
					</when>
					<otherwise >
						<db:update doc:name="Update" doc:id="9be9e459-142f-4a9b-8248-deaa4ebcabbb" config-ref="Database_Config">
							<db:sql ><![CDATA[UPDATE appointments
SET status = 'CANCELLED',
    cancelled_at = UTC_TIMESTAMP(),
    reminder_state = 'SUPPRESSED'
WHERE appointment_id = :appointmentId]]></db:sql>
							<db:input-parameters ><![CDATA[#[{
  appointmentId: vars.appointmentId
}]]]></db:input-parameters>
						</db:update>
						<db:update doc:name="Update" doc:id="f2d0f952-5d35-4a5a-a3cb-e3a928db9edb" config-ref="Database_Config">
							<db:sql ><![CDATA[UPDATE slots
SET status = 'OPEN',
    appointment_id = NULL,
    version = version + 1
WHERE appointment_id = :appointmentId]]></db:sql>
							<db:input-parameters ><![CDATA[#[{
  appointmentId: vars.appointmentId
}]]]></db:input-parameters>
						</db:update>
						<jms:publish
    doc:name="Publish Cancellation Event"
    config-ref="JMS_Config"
    destination="appointment.notify.queue">
    <jms:message>
        <jms:body><![CDATA[#[write({
            eventType: "APPOINTMENT_CANCELLED",
            appointmentId: vars.appointmentId,
            notifyType: "CANCELLATION",
            cancelledBy: "PATIENT",
            cancelReason: "Unable to attend",
            slotReleased: true
        }, "application/json")]]]></jms:body>
    </jms:message>
</jms:publish>
						<set-variable value="#[200]" doc:name="Set Variable" doc:id="cf839757-91bb-4bae-b9a2-bf6b5c5957c2" variableName="httpStatus"/>
						<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  message: "Appointment cancelled successfully",
  appointmentId: vars.appointmentId
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
					</otherwise>
				</choice>
			</otherwise>
		</choice>
    </flow>
    <flow name="get:\slots:api-config">
        <db:select doc:name="Select" doc:id="9be40030-3605-44d3-a493-a490e523e9ef" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT
    slot_id,
    clinic_id,
    practitioner_id,
    specialty,
    start_utc,
    end_utc,
    status
FROM slots
WHERE clinic_id = :clinicId
  AND DATE(start_utc) = :slotDate
  AND status = 'OPEN'
ORDER BY start_utc;]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
  clinicId: attributes.queryParams.clinicId,
  slotDate: attributes.queryParams.date
}]]]></db:input-parameters>
		</db:select>
		<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
	<flow name="post:\appointments:application\json:api-config">
        <set-variable value="#[payload]" doc:name="Set Variable" doc:id="f0a7143f-a7f8-4ec9-b730-59079f8b996b" variableName="bookingRequest"/>
		<db:select doc:name="Select" doc:id="af19a4e0-db88-4270-9fc8-8c5ee1c54f71" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT
    s.slot_id,
    s.clinic_id,
    s.practitioner_id,
    s.start_utc,
    s.end_utc,
    s.status,
    c.clinic_name,
    c.time_zone,
    p.practitioner_name
FROM slots s
JOIN clinics c
    ON s.clinic_id = c.clinic_id
JOIN practitioners p
    ON s.practitioner_id = p.practitioner_id
WHERE s.slot_id = :slotId
  AND s.clinic_id = :clinicId;]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
  slotId: payload.slotId,
  clinicId: payload.clinicId
}]]]></db:input-parameters>
		</db:select>
		<set-variable
    variableName="selectedSlot"
    value="#[payload[0]]"
    doc:name="Save Selected Slot"/>
		<logger level="INFO" doc:name="Logger" doc:id="df6d5695-f93a-44a4-bb40-217bcd038cb8" message='#[write(payload, "application/json")]'/>
		<choice doc:name="Choice" doc:id="5a92c128-4ac0-4182-a39e-68bdef51995a" >
			<when expression="#[!isEmpty(payload) and payload[0].start_utc &lt; now()]">
				<set-variable value="422" doc:name="Set Variable" doc:id="2b995656-30f6-49cb-93b5-154016fc2183" variableName="httpStatus"/>
				<ee:transform doc:name="Transform Message" doc:id="ec894308-425f-42d5-9e8e-80bd8cbee6d3" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  errorCode: "SLOT_IN_PAST",
  message: "Slot start time has passed."
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise >
				<choice doc:name="Choice" doc:id="d14e4df0-eeef-40ac-9cdf-049b8337397d">
			<when expression='#[!isEmpty(payload) and payload[0].status == "OPEN"]'>
				<set-variable value='#["APT-" ++ (now() as String {format: "yyyyMMddHHmmss"})]' doc:name="Set Variable" doc:id="77cd5f00-ec1d-4bc7-a370-dfe650c22834" variableName="appointmentId" />
				<set-variable
    variableName="bookingTimestamp"
    value="#[now()]"
    doc:name="Save Booking Timestamp"/>

<set-variable
    variableName="bookingCorrelationId"
    value="#[(attributes.headers.'x-correlation-id' default uuid()) as String]"
    doc:name="Save Booking Correlation ID"/>
				<set-variable value="201" doc:name="Set Variable" doc:id="c58071e7-9247-4fe2-aebb-a8539d729549" variableName="httpStatus" />
				<db:insert doc:name="Insert" doc:id="7b134a6e-2aee-4f00-a1d4-4559ad9218ec" config-ref="Database_Config">
					<db:sql><![CDATA[INSERT INTO appointments (
    appointment_id,
    patient_id,
    clinic_id,
    practitioner_id,
    slot_id,
    start_utc,
    reason_for_visit,
    status,
    request_id,
    correlation_id,
    booked_at,
    reminder_due_at,
    reminder_state
)
VALUES (
    :appointmentId,
    :patientId,
    :clinicId,
    :practitionerId,
    :slotId,
    :startUtc,
    :reasonForVisit,
    'BOOKED',
    :requestId,
    :correlationId,
    CURRENT_TIMESTAMP,
    :reminderDueAt,
    'SCHEDULED'
);]]></db:sql>
					<db:input-parameters><![CDATA[#[{
  appointmentId: vars.appointmentId,
  patientId: vars.bookingRequest.patientId,
  clinicId: vars.bookingRequest.clinicId,
  practitionerId: payload[0].practitioner_id,
  slotId: vars.bookingRequest.slotId,
  startUtc: vars.selectedSlot.start_utc,
  reasonForVisit: vars.bookingRequest.reasonForVisit,
  requestId: (attributes.headers.'x-request-id' default vars.bookingCorrelationId) as String,
correlationId: vars.bookingCorrelationId,
  reminderDueAt: (vars.selectedSlot.start_utc as LocalDateTime) - |PT1H|
}]]]></db:input-parameters>
				</db:insert>
				<db:update doc:name="Update" doc:id="4ba30ffe-b0a8-423c-b879-245c40e11464" config-ref="Database_Config">
					<db:sql><![CDATA[UPDATE slots
SET status = 'BOOKED',
    appointment_id = :appointmentId,
    version = version + 1
WHERE slot_id = :slotId
  AND clinic_id = :clinicId
  AND status = 'OPEN';]]></db:sql>
					<db:input-parameters><![CDATA[#[{
  appointmentId: vars.appointmentId,
  slotId: vars.bookingRequest.slotId,
  clinicId: vars.bookingRequest.clinicId
}]]]></db:input-parameters>
				</db:update>
                <!-- Preserve the HTTP response before changing payload for JMS. -->
                <set-variable variableName="bookingResponse" doc:name="Save Booking Response"
                    value="#[output application/java --- {
                        appointmentId: vars.appointmentId,
                        status: 'BOOKED',
                        clinicId: vars.bookingRequest.clinicId,
                        clinicName: vars.selectedSlot.clinic_name default null,
                        practitionerName: vars.selectedSlot.practitioner_name default null,
                        startLocal: vars.selectedSlot.start_utc as String,
                        timeZone: vars.selectedSlot.time_zone default null,
                        bookedAt: vars.bookingTimestamp as String,
                        reminderScheduledFor: ((vars.selectedSlot.start_utc as LocalDateTime) - |PT1H|) as String,
                        confirmationEmailQueued: false
                    }]"/>

                <!-- JMS failure is handled here so it does not replace the booking JSON response. -->
                <try doc:name="Publish Booking Confirmation Safely">
                    <set-payload
                        doc:name="Build Booking Event"
                        value="#[output application/java --- {
                            eventType: 'BOOKING_CONFIRMATION',
                            appointmentId: vars.appointmentId,
                            patientId: vars.bookingRequest.patientId,
                            clinicId: vars.bookingRequest.clinicId,
                            slotId: vars.bookingRequest.slotId,
                            correlationId: vars.bookingCorrelationId
                        }]"/>
                    <jms:publish
                        doc:name="Publish Booking Confirmation"
                        config-ref="JMS_Config"
                        destination="appointment.notify.queue">
                        <jms:message>
                            <jms:body>#[write(payload, 'application/json')]</jms:body>
                        </jms:message>
                    </jms:publish>
                    <set-variable variableName="bookingResponse" doc:name="Mark Confirmation Queued"
                        value="#[vars.bookingResponse ++ {confirmationEmailQueued: true}]"/>
                    <logger level="INFO" doc:name="Booking Event Published"
                        message="#['Booking event published for appointment ' ++ vars.appointmentId]"/>
                    <error-handler>
                        <on-error-continue type="ANY" logException="true" doc:name="Continue if JMS Publish Fails">
                            <logger level="ERROR" doc:name="Booking Event Publish Failed"
                                message="#['Booking saved but confirmation event could not be queued for appointment ' ++ vars.appointmentId]"/>
                        </on-error-continue>
                    </error-handler>
                </try>

                <!-- Restore the response object and explicitly serialize it as JSON. -->
                <ee:transform doc:name="Return Booking Response JSON">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
vars.bookingResponse]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
			</when>
			<otherwise>
				<set-variable value="409" doc:name="Set Variable" doc:id="2128d83b-5d1a-4a43-b1b5-1d55786eb770" variableName="httpStatus" />
				<ee:transform doc:name="Transform Message" doc:id="75e169a5-6852-4f6a-abd8-571a08600e35">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  errorCode: "SLOT_UNAVAILABLE",
  message: "The requested slot is not available."
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
			</otherwise>
		</choice>
    </flow>
</mule>