<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:db="http://www.mulesoft.org/schema/mule/db" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">
    <http:listener-config name="api-httpListenerConfig">
        <http:listener-connection host="0.0.0.0" port="8081" />
    </http:listener-config>
    <apikit:config name="api-config" api="api.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
	<flow name="api-main">
        <http:listener config-ref="api-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="api-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Bad request"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Method not allowed"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">405</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not acceptable"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">406</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Unsupported media type"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">415</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not Implemented"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">501</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="api-console">
        <http:listener config-ref="api-httpListenerConfig" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="api-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="delete:\appointments\(appointmentId):api-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="appointmentId"><![CDATA[%dw 2.0
output application/java
---
attributes.uriParams.'appointmentId']]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <db:select doc:name="Select" doc:id="24b6c023-d6d6-467d-9f10-a0b357d90f4b" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT appointment_id, slot_id, status
FROM appointments
WHERE appointment_id = :appointmentId]]></db:sql>
			<db:input-parameters ><![CDATA[#[{appointmentId: vars.appointmentId}]]]></db:input-parameters>
		</db:select>
		<choice doc:name="Choice" doc:id="c5cd0216-b843-4d7d-a0b6-627192f79eed" >
			<when expression="#[isEmpty(payload)]">
				<set-variable value="#[404]" doc:name="Set Variable" doc:id="feb028e0-2034-4e08-9316-a24eb9ac014c" variableName="httpStatus"/>
				<ee:transform doc:name="Transform Message" doc:id="abac5761-584f-4cad-b5e6-3d5bae4c7c10" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  error: "APPOINTMENT_NOT_FOUND",
  message: "Appointment not found"
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise >
				<choice doc:name="Choice" doc:id="c58aee13-386f-43fd-b721-376648e7ac86" >
					<when expression='#[upper(payload[0].status as String) == "CANCELLED"]'>
						<set-variable value="#[409]" doc:name="Set Variable" doc:id="bb093aa8-cae1-41e6-a31b-ab3fce81829d" variableName="httpStatus"/>
						<ee:transform doc:name="Transform Message" doc:id="8c23e09c-1441-45b5-b2ec-34828b59b1e0" >
							<ee:message >
								<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  error: "APPOINTMENT_ALREADY_CANCELLED",
  message: "Appointment is already cancelled"
}]]></ee:set-payload>
							</ee:message>
						</ee:transform>
					</when>
					<otherwise >
						<db:update doc:name="Update" doc:id="9104d353-b7c6-4ed0-b0d1-d66844c08145" config-ref="Database_Config">
							<db:sql ><![CDATA[UPDATE appointments
SET status = 'CANCELLED'
WHERE appointment_id = :appointmentId]]></db:sql>
							<db:input-parameters ><![CDATA[#[{
  appointmentId: vars.appointmentId
}]]]></db:input-parameters>
						</db:update>
						<db:update doc:name="Update" doc:id="3cb36bfc-d2a7-4993-87ba-4e641556027b" config-ref="Database_Config">
							<db:sql ><![CDATA[UPDATE slots
SET status = 'OPEN',
    appointment_id = NULL,
    version = version + 1
WHERE appointment_id = :appointmentId]]></db:sql>
							<db:input-parameters ><![CDATA[#[{
  appointmentId: vars.appointmentId
}]]]></db:input-parameters>
						</db:update>
						<set-variable value="#[200]" doc:name="Set Variable" doc:id="edc0f0d9-324b-4631-b46f-1df473b64436" variableName="httpStatus"/>
						<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  message: "Appointment cancelled successfully",
  appointmentId: vars.appointmentId
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
					</otherwise>
				</choice>
			</otherwise>
		</choice>
    </flow>
    <flow name="get:\slots:api-config">
        <db:select doc:name="Select" doc:id="49ea6db3-b13d-4a71-9e4f-08bdce6020cd" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT
    slot_id,
    clinic_id,
    practitioner_id,
    specialty,
    start_utc,
    end_utc,
    status
FROM slots
WHERE clinic_id = :clinicId
  AND DATE(start_utc) = :slotDate
  AND status = 'OPEN'
ORDER BY start_utc;]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
  clinicId: attributes.queryParams.clinicId,
  slotDate: attributes.queryParams.date
}]]]></db:input-parameters>
		</db:select>
		<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
	<flow name="post:\appointments:application\json:api-config">
        <set-variable value="#[payload]" doc:name="Set Variable" doc:id="0709bf32-702b-4696-929d-0fddc19c58d1" variableName="bookingRequest"/>
		<db:select doc:name="Select" doc:id="106b6c2e-55f8-40f3-a6ea-b57e0b032a31" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT
    slot_id,
    clinic_id,
    practitioner_id,
    start_utc,
    end_utc,
    status
FROM slots
WHERE slot_id = :slotId
  AND clinic_id = :clinicId;]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
  slotId: payload.slotId,
  clinicId: payload.clinicId
}]]]></db:input-parameters>
		</db:select>
		<logger level="INFO" doc:name="Logger" doc:id="331ff622-60be-42cb-a284-7a731d4c264a" message='#[write(payload, "application/json")]'/>
		<choice doc:name="Choice" doc:id="19556a68-f1e7-42b4-bef1-d77b6004a81d" >
			<when expression="#[!isEmpty(payload) and payload[0].start_utc &lt; now()]">
				<set-variable value="422" doc:name="Set Variable" doc:id="7db9423d-8eb2-4fcf-b5a7-7d55ece60db0" variableName="httpStatus"/>
				<ee:transform doc:name="Transform Message" doc:id="32c13572-a41b-452a-b915-c19197707003" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  errorCode: "SLOT_IN_PAST",
  message: "Slot start time has passed."
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise >
				<choice doc:name="Choice" doc:id="1bf3e5a2-b52a-4e24-b100-b225b6a9c1ab">
			<when expression='#[!isEmpty(payload) and payload[0].status == "OPEN"]'>
				<set-variable value='#["APT-" ++ (now() as String {format: "yyyyMMddHHmmss"})]' doc:name="Set Variable" doc:id="52151ad6-c100-4622-8858-f6ded4142ead" variableName="appointmentId" />
				<set-variable value="201" doc:name="Set Variable" doc:id="7bbc4184-7564-49d0-b4b5-27508069cf2e" variableName="httpStatus" />
				<db:insert doc:name="Insert" doc:id="584b76d8-9913-4141-8556-ae8bde05b119" config-ref="Database_Config">
					<db:sql><![CDATA[INSERT INTO appointments (
    appointment_id,
    patient_id,
    clinic_id,
    practitioner_id,
    slot_id,
    start_utc,
    reason_for_visit,
    status,
    request_id,
    correlation_id,
    booked_at,
    reminder_due_at,
    reminder_state
)
VALUES (
    :appointmentId,
    :patientId,
    :clinicId,
    :practitionerId,
    :slotId,
    :startUtc,
    :reasonForVisit,
    'BOOKED',
    :requestId,
    :correlationId,
    CURRENT_TIMESTAMP,
    :reminderDueAt,
    'SCHEDULED'
);]]></db:sql>
					<db:input-parameters><![CDATA[#[{
  appointmentId: vars.appointmentId,
  patientId: vars.bookingRequest.patientId,
  clinicId: vars.bookingRequest.clinicId,
  practitionerId: payload[0].practitioner_id,
  slotId: vars.bookingRequest.slotId,
  startUtc: payload[0].start_utc,
  reasonForVisit: vars.bookingRequest.reasonForVisit,
  requestId: (attributes.headers.'x-request-id' default uuid()) as String,
  correlationId: (attributes.headers.'x-correlation-id' default attributes.headers.'x-request-id' default uuid()) as String,
  reminderDueAt: (now() + |PT2H|) as LocalDateTime
}]]]></db:input-parameters>
				</db:insert>
				<db:update doc:name="Update" doc:id="aa2b6654-bc6e-4444-91b3-3c4f44a64120" config-ref="Database_Config">
					<db:sql><![CDATA[UPDATE slots
SET status = 'BOOKED',
    appointment_id = :appointmentId,
    version = version + 1
WHERE slot_id = :slotId
  AND clinic_id = :clinicId
  AND status = 'OPEN';]]></db:sql>
					<db:input-parameters><![CDATA[#[{
  appointmentId: vars.appointmentId,
  slotId: vars.bookingRequest.slotId,
  clinicId: vars.bookingRequest.clinicId
}]]]></db:input-parameters>
				</db:update>
				<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  message: "Booking request received",
  patientId: vars.bookingRequest.patientId,
  clinicId: vars.bookingRequest.clinicId,
  slotId: vars.bookingRequest.slotId,
  reasonForVisit: vars.bookingRequest.reasonForVisit
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
			</when>
			<otherwise>
				<set-variable value="409" doc:name="Set Variable" doc:id="9d3b050d-68dd-49ae-90ae-56982ae0e172" variableName="httpStatus" />
				<ee:transform doc:name="Transform Message" doc:id="8dbd6aa5-78d8-45dd-998e-592b8ee5f4c5">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  errorCode: "SLOT_UNAVAILABLE",
  message: "The requested slot is not available."
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
			</otherwise>
		</choice>
    </flow>
</mule>
